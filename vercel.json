{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    {
      "src": "^/api/.*$",
      "headers": {
        "x-vercel-enable-rewrite-caching": "0"
      },
      "continue": true
    },
    {
      "src": "^/(.*)$",
      "headers": {
        "X-Frame-Options": "SAMEORIGIN",
        "X-Content-Type-Options": "nosniff"
      },
      "continue": true
    },
    {
      "src": "^/(api/.*)$",
      "dest": "${API_ORIGIN}/$1",
      "env": ["API_ORIGIN"],
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-origin-secret"
          },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(audio/cache/[a-f0-9]{64}[.](?:mp3|wav)|generated/img_[a-f0-9]{64}[.](?:png|jpg|webp))$",
      "dest": "${API_ORIGIN}/$1",
      "env": ["API_ORIGIN"],
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-origin-secret"
          },
          "args": "$ORIGIN_SECRET",
          "env": ["ORIGIN_SECRET"]
        }
      ]
    },
    {
      "src": "^/(?!api/|assets/|audio/cache/|generated/).*$",
      "dest": "/index.html"
    }
  ]
}
