{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "risepath.lesson/v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "risepath.lesson/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Lesson id; the file is named <id>.lesson.json."
    },
    "courseId": {
      "description": "Slug of the course this lesson belongs to.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "$ref": "#/$defs/LText"
    },
    "subtitle": {
      "$ref": "#/$defs/LText"
    },
    "locale": {
      "description": "Source locale; plain strings are in this locale.",
      "$ref": "#/$defs/Locale"
    },
    "locales": {
      "description": "Locales that must be complete in every localized text.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Locale"
      }
    },
    "level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "estMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600,
      "description": "Estimated minutes to finish (1–600)."
    },
    "prerequisites": {
      "description": "What the learner should know first, e.g. an earlier lesson title.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/LText"
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Objective"
      },
      "description": "2–4 observable objectives."
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Section"
      }
    },
    "next": {
      "$ref": "#/$defs/LessonLink"
    },
    "glossary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GlossaryEntry"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "locale",
    "estMinutes",
    "objectives",
    "sections",
    "provenance"
  ],
  "additionalProperties": false,
  "description": "A Rise Path lesson (risepath.lesson/v1).",
  "$defs": {
    "LText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "jp": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "fr": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Plain text. A string is in lesson.locale; an object holds one string per locale."
    },
    "Locale": {
      "type": "string",
      "enum": [
        "jp",
        "en",
        "fr"
      ],
      "description": "Content locale key. \"jp\" is Japanese (BCP-47 \"ja\")."
    },
    "Objective": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "text": {
          "description": "Observable outcome, e.g. \"…を説明できる\" / \"Explain …\".",
          "$ref": "#/$defs/LText"
        },
        "bloom": {
          "$ref": "#/$defs/Bloom"
        }
      },
      "required": [
        "id",
        "text",
        "bloom"
      ],
      "additionalProperties": false,
      "description": "What the learner can do after the lesson."
    },
    "Bloom": {
      "type": "string",
      "enum": [
        "remember",
        "understand",
        "apply",
        "analyze",
        "evaluate",
        "create"
      ],
      "description": "Bloom taxonomy level of an objective or question."
    },
    "Section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "title": {
          "$ref": "#/$defs/LText"
        },
        "role": {
          "$ref": "#/$defs/SectionRole"
        },
        "blocks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        }
      },
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "additionalProperties": false,
      "description": "A titled group of blocks."
    },
    "SectionRole": {
      "type": "string",
      "enum": [
        "hook",
        "concept",
        "example",
        "practice",
        "check",
        "pitfalls",
        "summary",
        "reflection"
      ],
      "description": "Pedagogical role of a section."
    },
    "Block": {
      "description": "A lesson block, discriminated by \"type\".",
      "anyOf": [
        {
          "$ref": "#/$defs/MarkdownBlock"
        },
        {
          "$ref": "#/$defs/CalloutBlock"
        },
        {
          "$ref": "#/$defs/ListBlock"
        },
        {
          "$ref": "#/$defs/DefinitionsBlock"
        },
        {
          "$ref": "#/$defs/TableBlock"
        },
        {
          "$ref": "#/$defs/CodeBlock"
        },
        {
          "$ref": "#/$defs/PromptBlock"
        },
        {
          "$ref": "#/$defs/DiagramBlock"
        },
        {
          "$ref": "#/$defs/ImageBlock"
        },
        {
          "$ref": "#/$defs/QuizBlock"
        },
        {
          "$ref": "#/$defs/FlashcardsBlock"
        },
        {
          "$ref": "#/$defs/StepsBlock"
        },
        {
          "$ref": "#/$defs/ChecklistBlock"
        },
        {
          "$ref": "#/$defs/SummaryBlock"
        },
        {
          "$ref": "#/$defs/AskTutorBlock"
        }
      ]
    },
    "MarkdownBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "slide": {
          "description": "false hides the block in Slides mode.",
          "type": "boolean"
        },
        "narration": {
          "description": "Spoken text for Slides/listen mode (TTS).",
          "$ref": "#/$defs/LText"
        },
        "cite": {
          "description": "Ids of lesson.sources (or course.sources) that back this block.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
          }
        },
        "type": {
          "type": "string",
          "const": "markdown"
        },
        "md": {
          "$ref": "#/$defs/Md"
        },
        "style": {
          "type": "string",
          "enum": [
            "normal",
            "lead",
            "quote"
          ]
        }
      },
      "required": [
        "id",
        "type",
        "md"
      ],
      "additionalProperties": false,
      "description": "Prose paragraph(s). Keep each paragraph within 160 JP characters / 80 EN words."
    },
    "Md": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "jp": {
              "type": "string"
            },
            "en": {
              "type": "string"
            },
            "fr": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Inline markdown: **bold**, *italic*, `code`, [link](https://…), [[glossary term]], line breaks."
    },
    "CalloutBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "slide": {
          "description": "false hides the block in Slides mode.",
          "type": "boolean"
        },
        "narration": {
          "description": "Spoken text for Slides/listen mode (TTS).",
          "$ref": "#/$defs/LText"
        },
        "cite": {
          "description": "Ids of lesson.sources (or course.sources) that back this block.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
          }
        },
        "type": {
          "type": "string",
          "const": "callout"
        },
        "variant": {
          "type": "string",
          "enum": [
            "tip",
            "warning",
            "info",
            "analogy",
            "pitfall",
            "note",
            "success"
          ]
        },
        "title": {
          "$ref": "#/$defs/LText"
        },
        "md": {
          "$ref": "#/$defs/Md"
        }
      },
      "required": [
        "id",
        "type",
        "variant",
        "md"
      ],
      "additionalProperties": false,
      "description": "Highlighted note. At most 2 per section; an analogy goes before the formal definition."
    },
    "ListBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "slide": {
          "description": "false hides the block in Slides mode.",
          "type": "boolean"
        },
        "narration": {
          "description": "Spoken text for Slides/listen mode (TTS).",
          "$ref": "#/$defs/LText"
        },
        "cite": {
          "description": "Ids of lesson.sources (or course.sources) that back this block.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
          }
        },
        "type": {
          "type": "string",
          "const": "list"
        },
        "style": {
          "type": "string",
          "enum": [
            "bullet",
            "number",
            "check"
          ]
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Md"
          }
        }
      },
      "required": [
        "id",
        "type",
        "items"
      ],
      "additionalProperties": false,
      "description": "Bulleted, numbered or check list (7 items max). Use definitions for \"label: description\" items."
    },
    "DefinitionsBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "slide": {
          "description": "false hides the block in Slides mode.",
          "type": "boolean"
        },
        "narration": {
          "description": "Spoken text for Slides/listen mode (TTS).",
          "$ref": "#/$defs/LText"
        },
        "cite": {
          "description": "Ids of lesson.sources (or course.sources) that back this block.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
          }
        },
        "type": {
          "type": "string",
          "const": "definitions"
        },
        "items": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "term": {
                "$ref": "#/$defs/LText"
              },
              "md": {
                "$ref": "#/$defs/Md"
              }
            },
            "required": [
              "term",
              "md"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "type",
        "items"
      ],
      "additionalProperties": false,
      "description": "Term / description pairs, rendered as a definition list."
    },
    "TableBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "slide": {
          "description": "false hides the block in Slides mode.",
          "type": "boolean"
        },
        "narration": {
          "description": "Spoken text for Slides/listen mode (TTS).",
          "$ref": "#/$defs/LText"
        },
        "cite": {
          "description": "Ids of lesson.sources (or course.sources) that back this block.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
          }
        },
        "type": {
          "type": "string",
          "const": "table"
        },
        "caption": {
          "$ref": "#/$defs/LText"
        },
        "columns": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/LText"
          }
        },
        "rows": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Md"
            }
          }
        }
      },
      "required": [
        "id",
        "type",
        "columns",
        "rows"
      ],
      "additionalProperties": false,
      "description": "Data table (6 columns max). Every row has one cell per column."
    },
    "CodeBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "slide": {
          "description": "false hides the block in Slides mode.",
          "type": "boolean"
        },
        "narration": {
          "description": "Spoken text for Slides/listen mode (TTS).",
          "$ref": "#/$defs/LText"
        },
        "cite": {
          "description": "Ids of lesson.sources (or course.sources) that back this block.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
          }
        },
        "type": {
          "type": "string",
          "const": "code"
        },
        "lang": {
          "type": "string",
          "minLength": 1,
          "description": "Language id for highlighting, e.g. ts, bash, json, python."
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "description": "Shown in the code header. Recommended.",
          "type": "string"
        },
        "highlight": {
          "description": "1-based line numbers to emphasize.",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "id",
        "type",
        "lang",
        "code"
      ],
      "additionalProperties": false,
      "description": "Source code (25 lines max inline). Instructions to an AI go in a prompt block, not here."
    },
    "PromptBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "slide": {
          "description": "false hides the block in Slides mode.",
          "type": "boolean"
        },
        "narration": {
          "description": "Spoken text for Slides/listen mode (TTS).",
          "$ref": "#/$defs/LText"
        },
        "cite": {
          "description": "Ids of lesson.sources (or course.sources) that back this block.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
          }
        },
        "type": {
          "type": "string",
          "const": "prompt"
        },
        "title": {
          "$ref": "#/$defs/LText"
        },
        "prompt": {
          "description": "The instruction to give an AI. {{name}} marks an editable variable.",
          "$ref": "#/$defs/LText"
        },
        "target": {
          "type": "string",
          "enum": [
            "any",
            "claude",
            "claude-code",
            "chatgpt",
            "gemini"
          ]
        },
        "vars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Variable name as written inside {{ }} in the prompt."
              },
              "hint": {
                "$ref": "#/$defs/LText"
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        },
        "expect": {
          "description": "What a good AI answer looks like (shown collapsed).",
          "$ref": "#/$defs/Md"
        },
        "note": {
          "$ref": "#/$defs/Md"
        }
      },
      "required": [
        "id",
        "type",
        "prompt"
      ],
      "additionalProperties": false,
      "description": "A prompt the learner can copy into an AI tool. Every example instruction to an AI uses this block."
    },
    "DiagramBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "slide": {
          "description": "false hides the block in Slides mode.",
          "type": "boolean"
        },
        "narration": {
          "description": "Spoken text for Slides/listen mode (TTS).",
          "$ref": "#/$defs/LText"
        },
        "cite": {
          "description": "Ids of lesson.sources (or course.sources) that back this block.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
          }
        },
        "type": {
          "type": "string",
          "const": "diagram"
        },
        "engine": {
          "type": "string",
          "const": "mermaid"
        },
        "code": {
          "description": "Mermaid source (flowchart, sequence, er, mindmap, …). May be localized per locale.",
          "$ref": "#/$defs/LText"
        },
        "caption": {
          "$ref": "#/$defs/LText"
        },
        "alt": {
          "description": "Short text alternative for screen readers.",
          "$ref": "#/$defs/LText"
        },
        "description": {
          "description": "Longer prose explanation shown under the figure.",
          "$ref": "#/$defs/Md"
        }
      },
      "required": [
        "id",
        "type",
        "engine",
        "code",
        "alt"
      ],
      "additionalProperties": false,
      "description": "Mermaid diagram (12 nodes max) with caption and alt text. Mind maps use mermaid \"mindmap\" syntax."
    },
    "ImageBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "slide": {
          "description": "false hides the block in Slides mode.",
          "type": "boolean"
        },
        "narration": {
          "description": "Spoken text for Slides/listen mode (TTS).",
          "$ref": "#/$defs/LText"
        },
        "cite": {
          "description": "Ids of lesson.sources (or course.sources) that back this block.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
          }
        },
        "type": {
          "type": "string",
          "const": "image"
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "alt": {
          "$ref": "#/$defs/LText"
        },
        "caption": {
          "$ref": "#/$defs/LText"
        },
        "layout": {
          "type": "string",
          "enum": [
            "inline",
            "wide"
          ]
        },
        "decorative": {
          "description": "Decorative images belong on the course cover only.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "src",
        "alt"
      ],
      "additionalProperties": false,
      "description": "A teaching image (screenshot, comparison). Alt text is required."
    },
    "QuizBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
        },
        "slide": {
          "description": "false hides the block in Slides mode.",
          "type": "boolean"
        },
        "narration": {
          "description": "Spoken text for Slides/listen mode (TTS).",
          "$ref": "#/$defs/LText"
        },
        "cite": {
          "description": "Ids of lesson.sources (or course.sources) that back this block.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$",
            "description": "Stable id: lowercase letters, digits, \".\", \"_\" or \"-\". Unique within the lesson."
          }
        },
        "type": {
          "type": "string",
          "const": "quiz"
        },
        "mode": {
          "type": "string",
          "enum": [
            "inline",
            "exam",
            "predict"
          ],
          "description": "inline = a check while reading (確認しよう); exam = end-of-lesson test; predict = an ungraded prediction in the hook (the pick is not scored; the explanation is revealed after answering)."
        },
        "title": {
          "$ref": "#/$defs/LText"
