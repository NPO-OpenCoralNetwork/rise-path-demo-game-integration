# === Rise Path Environment Configuration ===

# --- Required for Production ---

# Supabase (Auth ONLY — do not use Supabase Postgres URI for app data)
# Use the same Supabase project as Nexloom if you want the same email/password.
# Setup: doc/env_local_setup_issue15.md — verify: npm run env:check -- --db --auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_BASE_PATH=/

# Supabase Backend (JWT validation — Phase 7)
# Service Role Key recommended for server-side JWT validation.
# Falls back to VITE_SUPABASE_* if not set.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Development mode user ID (ignored in production)
PHASE1_USER_ID=00000000-0000-0000-0000-000000000001

# PostgreSQL Database
DATABASE_URL_PHASE1=postgresql://user:password@host:5432/risepath

# --- LLM gateway (server only: /api/v2/llm, see server/llm/models.config.js) ---
# Model keys live on the server. NEVER set VITE_GEMINI_API_KEY / VITE_ANTHROPIC_API_KEY:
# every VITE_* value is shipped to the browser (vite.config.ts blanks these, but don't rely on it).
# With no key set, the gateway answers from a built-in mock outside production;
# in production it returns 503 unless LLM_PROVIDER=mock.
ANTHROPIC_API_KEY=
# Gemini (backend — also used by legacy /ai/generate and the material RAG embeddings
# (tools/core/ragSearch.js; model from server/llm/models.config.js). v3 prefers Hermes)
# RAG never compares vectors from different embedding models. Chunks stored with an older model
# or none are matched by keyword until re-embedded (no npm script needed):
#   node scripts/rag/reembed.mjs --dry-run     # count stale chunks per model, change nothing
#   node scripts/rag/reembed.mjs [--limit N] [--batch-size 100]   # idempotent, safe to rerun
GEMINI_API_KEY=your-gemini-api-key
# Force every task onto one provider: anthropic | gemini | mock
# LLM_PROVIDER=
# Per-task override: LLM_TASK_<TASK>=provider[:model], e.g. LLM_TASK_TUTOR_CHAT=gemini:gemini-3.8-flash
# Set to 'false' to disable the mock fallback when the routed provider has no key (dev only)
# LLM_MOCK_FALLBACK=false
# LLM_TIMEOUT_MS=120000
# Browser origins that may call the API (CORS on every route, and the guest lesson tutor), besides
# the API's own host (comma-separated). Unless the API runs with NODE_ENV=production, the Vite dev
# server (:3007, localhost) is always allowed; the dev server's own proxy needs no entry here.
# LLM_ALLOWED_ORIGINS=https://risepath.example
# Daily budget for anonymous LLM calls (in memory, reset at 00:00 UTC):
# LLM_GUEST_DAILY_PER_IP=100
# LLM_GUEST_DAILY_TOTAL=2000
# Behind a reverse proxy: number of proxy hops (or true) so per-IP limits see the client IP.
# TRUST_PROXY=1

# Hermes Agent API Server (Phase 16-6 — Express proxy target)
# See hermes/README.md for profile setup
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me-local-dev

# --- Optional ---

# Demo mode: set to 'false' for production (uses DB for course data)
# Also enables strict auth (no guest/mock login, no server PHASE1 fallback)
# Default: true (uses bundled demo course data)
VITE_DEMO_MODE=true
# RISEPATH_STRICT_AUTH=true
# VITE_STRICT_AUTH=true

# API enabled: set to 'false' to use localStorage-only mode
# Default: true
VITE_API_ENABLED=true
VITE_API_BASE_URL=/api/v2

# Server port (default: 3006)
PORT=3006

# --- Kokoro TTS (optional — Issue #3) ---
# ONNX sidecar on risepath-vm. See doc/ai-curriculum-spec/09_content_types_tts.md
KOKORO_TTS_URL=http://127.0.0.1:8880
KOKORO_TTS_DEFAULT_VOICE_JA=jf_alpha
KOKORO_TTS_DEFAULT_VOICE_EN=af_bella

# --- Lesson authoring (MCP lesson-* tools: tools/core/lessons.js, mcp-server/index.js) ---
# Where lesson-upsert-draft writes: fs (default; content/courses/<slug>/drafts/<id>.lesson.json)
# or db (curriculum_versions draft rows; needs DATABASE_URL_PHASE1).
# RP_LESSON_STORE=fs
# content/ root the lesson tools read and write (default: the repo's content/). Tests/smoke use a temp copy.
# RP_CONTENT_DIR=
# A production SSE MCP server (--sse, NODE_ENV=production) refuses file drafts unless this is 1;
# prefer RP_LESSON_STORE=db there.
# RP_LESSON_FS_WRITE=0
# Base URL that lesson-preview-url links to (the web app, which serves /preview/...).
# RISE_PATH_PREVIEW_BASE_URL=http://localhost:3007

# --- Nexloom Integration (optional) ---
# Lesson-completion bridge (services/nexloomWorldsBridge.ts). All of these are public client
# config: VITE_* values are shipped to the browser. The bridge authenticates with the signed-in
# learner's Supabase session only.
VITE_NEXLOOM_WORLDS_BASE_URL=
VITE_NEXLOOM_REALM_ID=
VITE_NEXLOOM_WORLDS_ORGANIZATION_ID=
# Optional track routing: JSON map (course/curriculum/lesson key → track id) and defaults.
# VITE_NEXLOOM_RISE_PATH_TRACK_MAP=
# VITE_NEXLOOM_RISE_PATH_DEFAULT_TRACK_KEY=
# VITE_NEXLOOM_RISE_PATH_DEFAULT_TRACK_ID=
# VITE_NEXLOOM_RISE_PATH_DEFAULT_PROVIDER_CURRICULUM_ID=
# NEVER set VITE_NEXLOOM_WORLDS_BEARER_TOKEN (removed): a service bearer token in a VITE_* var is
# public. If service-to-service progress reporting is needed, add a server proxy that reads a
# server-only token (e.g. NEXLOOM_WORLDS_BEARER_TOKEN) instead.
