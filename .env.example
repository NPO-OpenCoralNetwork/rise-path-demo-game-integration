# === Rise Path Environment Configuration ===

# --- Required for Production ---

# Supabase (Auth ONLY — do not use Supabase Postgres URI for app data)
# Use the same Supabase project as Nexloom if you want the same email/password.
# Setup: doc/env_local_setup_issue15.md — verify: npm run env:check -- --db --auth
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_BASE_PATH=/

# Supabase Backend (JWT validation — Phase 7)
# Service Role Key recommended for server-side JWT validation.
# Falls back to VITE_SUPABASE_* if not set.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Development mode user ID (ignored in production)
PHASE1_USER_ID=00000000-0000-0000-0000-000000000001

# PostgreSQL Database
DATABASE_URL_PHASE1=postgresql://user:password@host:5432/risepath
# Pool settings (server/db.js; milliseconds). Getting a connection gives up after
# PG_CONNECT_TIMEOUT_MS (default 10000), so a database that stopped answering fails requests instead
# of holding them; a request queued behind a full pool (PG_POOL_MAX connections, default 10) waits as
# long at most. PG_STATEMENT_TIMEOUT_MS (default: none) makes Postgres cancel longer statements; it
# overrides the role's own setting, so leave it unset for a role that has one (mcp-public's: 10 s).
# PG_CONNECT_TIMEOUT_MS=10000
# PG_POOL_MAX=10
# PG_STATEMENT_TIMEOUT_MS=30000

# --- LLM gateway (server only: /api/v2/llm, see server/llm/models.config.js) ---
# Model keys live on the server. NEVER set VITE_GEMINI_API_KEY / VITE_ANTHROPIC_API_KEY:
# every VITE_* value is shipped to the browser (vite.config.ts blanks these, but don't rely on it).
# With no key set, the gateway answers from a built-in mock outside production;
# in production it returns 503 unless LLM_PROVIDER=mock.
# The AI tutor (tutor.chat), writing feedback (writing.feedback) and course generation
# (/api/v2/ai/generate, task course.generate) run on the cheap Claude model (Claude Haiku) by default.
ANTHROPIC_API_KEY=
# Gemini (chat provider, RAG embeddings, image generation) is used ONLY when GEMINI_ALLOWED is
# exactly "true". Unset or anything else = off, even when GEMINI_API_KEY is set (the server logs a
# warning). Reason: the Gemini API Additional Terms (https://ai.google.dev/gemini-api/terms) forbid
# services "directed towards or is likely to be accessed by individuals under the age of 18", and
# minors use Rise Path. Set it only for deployments that people under 18 cannot reach.
# With Gemini off: uploads are stored without vectors and found by keyword search, and
# /api/v2/image answers 503 image_generation_unavailable.
# GEMINI_ALLOWED=true
# GEMINI_API_KEY=
# RAG never compares vectors from different embedding models. Chunks stored with an older model
# or none (e.g. uploaded while Gemini was off) are matched by keyword until re-embedded
# (needs GEMINI_ALLOWED=true and a key; no npm script needed):
#   node scripts/rag/reembed.mjs --dry-run     # count stale chunks per model, change nothing
#   node scripts/rag/reembed.mjs [--limit N] [--batch-size 100]   # idempotent, safe to rerun
# Force every task onto one provider: anthropic | gemini | mock
# LLM_PROVIDER=
# Per-task override: LLM_TASK_<TASK>=provider[:model]. To move a task back to the larger model:
# LLM_TASK_TUTOR_CHAT=anthropic:claude-sonnet-5-5
# LLM_TASK_WRITING_FEEDBACK=anthropic:claude-sonnet-5-5
# LLM_TASK_COURSE_GENERATE=anthropic:claude-sonnet-5-5
# Set to 'false' to disable the mock fallback when the routed provider has no key (dev only)
# LLM_MOCK_FALLBACK=false
# LLM_TIMEOUT_MS=120000
# Browser origins that may call the API, besides the API's own host (comma-separated): CORS on
# every route, and a POST to /api/v2/llm from any other origin gets 403. Unless the API runs with
# NODE_ENV=production, localhost and 127.0.0.1 (any port) and port 3007 on any host are allowed.
# LLM_ALLOWED_ORIGINS=https://risepath.example
# Daily budget for anonymous LLM calls, used only with LLM_GUEST_AI=true (in memory, reset at
# 00:00 JST). Guest calls do not count toward AI_CAP_GLOBAL_LLM below; this is their own total:
# LLM_GUEST_DAILY_PER_IP=100
# LLM_GUEST_DAILY_TOTAL=2000
# Daily caps on paid AI features for signed-in users (server/middleware/dailyCaps.js). The day is
# the Japan-time date (reset at 00:00 JST); counts are kept in ai_daily_usage (migration 013).
# USER is per user per day, IP per visitor address per day (an IPv6 visitor by its /56, as the
# guest budget and the per-minute limiter group them; default 3 x USER; loopback and private
# addresses are not counted), GLOBAL is all users together per day.
# 0 turns the feature off for everyone, guests included (the app says it is paused); there is
# no unlimited value (raise the number instead), so the GLOBAL caps always work as cost breakers. Admins
# (user_profiles.role = 'admin') skip the USER and IP caps, not the GLOBAL one. Bridge-token calls
# all run as PHASE1_USER_ID and share one USER count. Guests are not counted here (see the guest
# budget above). Without a database the counts are in memory and reset on restart. During a
# database outage each process counts again from 0 in memory: a user can get one more full USER
# cap that day, and the GLOBAL cap drops to a tenth meanwhile (about 1.1 x GLOBAL per process);
# past that tenth, callers get 503 "busy" (not the daily-limit notice) until the database answers.
# A school or office behind one address shares the IP cap: raise AI_CAP_IP_* for it.
# AI_DAILY_LIMIT is no longer read.
# AI_CAP_USER_LLM=50
# AI_CAP_IP_LLM=150
# AI_CAP_GLOBAL_LLM=1500
# AI_CAP_USER_COURSE_GENERATION=20
# AI_CAP_IP_COURSE_GENERATION=60
# AI_CAP_GLOBAL_COURSE_GENERATION=300
# AI_CAP_USER_IMAGE=30
# AI_CAP_IP_IMAGE=90
# AI_CAP_GLOBAL_IMAGE=300
# AI_CAP_USER_AGENT_CHAT=40
# AI_CAP_IP_AGENT_CHAT=120
# AI_CAP_GLOBAL_AGENT_CHAT=800
# AI_CAP_USER_EMBEDDINGS=10
# AI_CAP_IP_EMBEDDINGS=30
# AI_CAP_GLOBAL_EMBEDDINGS=100
# Reaching 80% and 100% of a GLOBAL cap is logged as an error ("[AI caps] global daily cap"),
# once a day per feature. Optional: also post it to a Slack- or Discord-style incoming webhook
# (https:// only; http:// only to localhost). The URL is a secret: it is never logged.
# AI_CAP_ALERT_WEBHOOK_URL=
# A GLOBAL count used up by something that was not real use (a provider key that was rejected,
# say): after the fix, reset that feature's all-users count for today. <kind> is llm,
# course_generation, image, agent_chat or embeddings; the day is the Japan-time date:
#   DELETE FROM ai_daily_usage WHERE usage_day = (now() AT TIME ZONE 'Asia/Tokyo')::date
#     AND kind = '<kind>' AND subject = '*';
# Behind a reverse proxy: number of proxy hops (or true) so per-IP limits see the client IP.
# TRUST_PROXY=1

# --- Minor safeguards (Phase 0.5, doc/brushup-2026/ai-access-plan.ja.md §4; server/safety/) ---
# Every AI call (tutor, writing feedback, assessment insight, course generation) needs a signed-in
# learner with a recorded birth year and month; under 18 also a guardian's consent. Minors' input
# and output go through a Claude safety check (task safety.screen). Operations guide:
# doc/guides/safety-operations.ja.md.
# Anonymous (guest) AI calls answer 401 unless this is exactly "true". Set it ONLY on deployments
# that people under 18 cannot reach: guests then count as adults (no age, no consent, no checks).
# LLM_GUEST_AI=true
# Blocked inputs per learner per Japan-time day before their AI pauses until 00:00 JST
# (default 10; 0 = never pause). Support-line answers (distress) and
# personal-information blocks (category personal_info) never count.
# SAFETY_BLOCKS_BEFORE_PAUSE=10
# Where safety alerts go (new report, support lines shown, an answer held back, a failed check,
# a learner paused): a Slack- or Discord-style incoming webhook, https:// only. Unset = the
# AI_CAP_ALERT_WEBHOOK_URL above. Alerts never contain learner text. The URL is a secret.
# SAFETY_ALERT_WEBHOOK_URL=
# Development only: answer every signed-in user as this audience without reading the database
# ('adult' or 'minor'; 'minor' turns on the child-safety prompt and the checks). Ignored when
# NODE_ENV=production (the server warns at startup). Without a database outside production the
# audience is 'adult'.
# AI_ACCESS_DEV_AUDIENCE=minor

# --- The supporter plan (Phase 3; server/services/billingConfig.js, /api/v2/billing) ---
# Off unless these are set. Server only: NEVER set VITE_STRIPE_* (vite.config.ts blanks them; the
# browser needs no Stripe value). On the VM they go in deploy/risepath-vm/billing.env (api only;
# billing.env.example explains each one), never in stack.env. Stripe TEST mode (sk_test_/rk_test_)
# only until the legal and tax checks: test mode limits buying and the supporter caps to
# BILLING_TEST_USER_IDS. A live key also needs BILLING_LIVE=true, the 特商法 facts filled in
# (server/services/billingDisclosure.js) and BILLING_TOS_URL. Locally, forward Stripe's events with
#   stripe listen --forward-to localhost:3006/api/v2/billing/webhook
# and put the whsec_ it prints into STRIPE_WEBHOOK_SECRET. Outside production the return origin may
# be http://localhost:3007. BILLING_ENABLED=true opens sales; anything else only stops new sales
# (the webhook, the portal and existing subscribers keep working).
# BILLING_ENABLED=
# BILLING_LIVE=
# BILLING_TEST_USER_IDS=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# STRIPE_PRICE_IDS_ACCEPTED=
# BILLING_RETURN_ORIGIN=http://localhost:3007
# BILLING_TOS_URL=
# All supporters together per Japan-time day (defaults 1000 and 200; 0 = off for supporters):
# AI_CAP_SUPPORTER_GLOBAL_LLM=1000
# AI_CAP_SUPPORTER_GLOBAL_COURSE_GENERATION=200
# Front end (build time, config/features.ts): exactly "true" shows /settings/plan, its confirmation
# screen and the Settings/profile entry points (only for learners GET /api/v2/billing/me allows).
# The public /legal/commerce page does not depend on it. Off by default.
# VITE_FEATURE_BILLING=true

# --- Account deletion and retention (Phase 4; server only; none is a secret) ---
# Settings → delete account (POST /api/v2/user/account/deletion; the shared Supabase login stays).
# Starts off: true (or 1, on, yes) turns it on; unset, empty or false keeps it off; any other value
# keeps it off (the server logs a warning). Turn it on only after the Supabase "Require current
# password when updating" check and the production amr check (ai-access-plan §8.2 items 2-3).
# ACCOUNT_DELETION_ENABLED=true
# Retention (server/services/retention.js, hourly in node server.js): old AI usage counts,
# processing records and the proofs of deleted accounts. Off by default outside
# NODE_ENV=production: a local api (npm run dev) runs it only with RETENTION_ENABLED=true. Keep it
# off when DATABASE_URL_PHASE1 points at the VM database: the laptop's settings would delete there
# and ignore stack.env. It also removes files in uploads/ (and public/uploads, from older versions)
# that no materials row names after 24 hours, so a local database that was reset loses the old upload
# files too. An invalid period
# turns only its rule off (logged on every run). Defaults (RETENTION_ENABLED: production only):
# RETENTION_ENABLED=true
# RETENTION_AI_USAGE_DAYS=30
# RETENTION_PROCESSING_DAYS=365
# RETENTION_DELETION_PROOF_YEARS=5
# RETENTION_AI_APP_RECORD_YEARS=3
# Front end (build time, config/support.ts): where learners send deletion and other requests, an
# https:// URL (a contact form) or mailto: with one address. Shown on the delete-account and
# account-deleted pages; unset, they say to tell the staff at the learning site. Not a secret.
# VITE_SUPPORT_CONTACT=https://forms.example.org/rise-path
# The legal pages and the consent flow (Phase 4; config/features.ts): exactly true serves /terms and
# /privacy with the published text, the sign-up checkbox, the re-consent page and change notices.
# Dev builds (npm run dev) always show the draft pages with a banner; the consent flow needs true.
# A production build refuses true while the text is a draft (scripts/legal/check-legal-release.mjs).
# Public sign-up opens only with it on, after the lawyer's sign-off (doc/legal/README.md).
# VITE_FEATURE_LEGAL_PAGES=true
# Server (Phase 8; not a secret): true also refuses a signed-in learner's API calls with 403
# terms_required until they accept (server/middleware/termsGate.js; its TERMS_EXEMPT routes stay
# open). Use it only together with VITE_FEATURE_LEGAL_PAGES=true (the consent page); off by
# default. Outside production it works with the draft texts; NODE_ENV=production ignores it then.
# LEGAL_TERMS_REQUIRED=true

# Hermes Agent API Server (Phase 16-6 — Express proxy target)
# See hermes/README.md for profile setup
HERMES_API_URL=http://127.0.0.1:8642
HERMES_API_KEY=change-me-local-dev

# --- Optional ---

# Demo mode: set to 'false' for production (uses DB for course data)
# Also enables strict auth (no guest/mock login, no server PHASE1 fallback)
# Default: true (uses bundled demo course data)
VITE_DEMO_MODE=true
# RISEPATH_STRICT_AUTH=true
# VITE_STRICT_AUTH=true

# API enabled: set to 'false' to use localStorage-only mode
# Default: true
VITE_API_ENABLED=true
VITE_API_BASE_URL=/api/v2

# Shared Hermes agent chats (the floating AI coach and /life-journal/chat; config/features.ts).
# Shown only when exactly 'true'. Default off: the shared server-side agent is not offered to
# learners (doc/brushup-2026/ai-access-plan.ja.md). The in-lesson AI tutor is not affected.
# The API server reads the same switch: POST /api/v2/agent/chat answers 404 unless it is 'true'.
# VITE_FEATURE_AGENT_CHAT=true

# Server port (default: 3006)
PORT=3006

# --- Kokoro TTS (optional — Issue #3) ---
# ONNX sidecar on risepath-vm. See doc/ai-curriculum-spec/09_content_types_tts.md
KOKORO_TTS_URL=http://127.0.0.1:8880
KOKORO_TTS_DEFAULT_VOICE_JA=jf_alpha
KOKORO_TTS_DEFAULT_VOICE_EN=af_bella

# --- Lesson authoring (MCP lesson-* tools: tools/core/lessons.js, mcp-server/index.js) ---
# Where lesson-upsert-draft writes: fs (default; content/courses/<slug>/drafts/<id>.lesson.json)
# or db (curriculum_versions draft rows; needs DATABASE_URL_PHASE1).
# RP_LESSON_STORE=fs
# content/ root the lesson tools read and write (default: the repo's content/). Tests/smoke use a temp copy.
# RP_CONTENT_DIR=
# A production SSE MCP server (--sse, NODE_ENV=production) refuses file drafts unless this is 1;
# prefer RP_LESSON_STORE=db there.
# RP_LESSON_FS_WRITE=0
# Base URL that lesson-preview-url links to (the web app, which serves /preview/...).
# RISE_PATH_PREVIEW_BASE_URL=http://localhost:3007

# --- Nexloom Integration (optional) ---
# Lesson-completion bridge (services/nexloomWorldsBridge.ts). All of these are public client
# config: VITE_* values are shipped to the browser. The bridge authenticates with the signed-in
# learner's Supabase session only.
VITE_NEXLOOM_WORLDS_BASE_URL=
VITE_NEXLOOM_REALM_ID=
VITE_NEXLOOM_WORLDS_ORGANIZATION_ID=
# Optional track routing: JSON map (course/curriculum/lesson key → track id) and defaults.
# VITE_NEXLOOM_RISE_PATH_TRACK_MAP=
# VITE_NEXLOOM_RISE_PATH_DEFAULT_TRACK_KEY=
# VITE_NEXLOOM_RISE_PATH_DEFAULT_TRACK_ID=
# VITE_NEXLOOM_RISE_PATH_DEFAULT_PROVIDER_CURRICULUM_ID=
# NEVER set VITE_NEXLOOM_WORLDS_BEARER_TOKEN (removed): a service bearer token in a VITE_* var is
# public. If service-to-service progress reporting is needed, add a server proxy that reads a
# server-only token (e.g. NEXLOOM_WORLDS_BEARER_TOKEN) instead.
