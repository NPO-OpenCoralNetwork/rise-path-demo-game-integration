# The daily backup (Phase 9, owner decision D4; design §5.6; doc/guides/first-launch.ja.md 6.4). Installed by
# deploy/risepath-vm/scripts/install-backup.sh; started by risepath-backup.timer. A failure, a timeout or a start that
# never happened runs risepath-backup-alert@risepath-backup.service (one fixed Slack line).
[Unit]
Description=Rise Path daily backup (database and uploads, encrypted, to Cloud Storage)
After=docker.service risepath-stack.service
Requires=docker.service
OnFailure=risepath-backup-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/risepath/deploy/risepath-vm
ExecStart=/opt/risepath/deploy/risepath-vm/scripts/backup.sh daily
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600
