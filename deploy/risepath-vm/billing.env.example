# The supporter plan (Phase 3; server/services/billingConfig.js). Read by the api service only
# (docker-compose.yml env_file), never by mcp or mcp-public:
#   cp billing.env.example billing.env && chmod 600 billing.env
# billing.env is git-ignored. STRIPE_* and BILLING_* belong here only: deploy-stack.sh refuses
# them in stack.env and mcp-public.env. Never put a Stripe key in a VITE_* variable: the browser
# needs none (the client only calls /api/v2/billing).
#
# Off by default. With every value empty the api logs "billing: off" and answers 404 billing_off.
# TEST MODE ONLY (sk_test_/rk_test_ keys) until the legal and tax checks and the owner's OK:
# test mode runs on the production API, so only BILLING_TEST_USER_IDS can buy or get the
# supporter caps there. Test locally first with
#   stripe listen --forward-to localhost:3006/api/v2/billing/webhook
# (its own whsec_ goes into STRIPE_WEBHOOK_SECRET of that local server).

# Sales switch: exactly "true" opens POST /checkout. Any other value only stops new sales; the
# webhook, the portal and existing subscribers keep working (stop selling = set it to false;
# to wind down, cancel the subscriptions in the Stripe Dashboard first).
BILLING_ENABLED=
# Exactly "true" is required before a live key (sk_live_/rk_live_) is accepted, and live sales also
# need the 特商法 facts filled in (server/services/billingDisclosure.js) and BILLING_TOS_URL.
BILLING_LIVE=
# Test mode: comma-separated Rise Path user ids (uuid) allowed to buy and to get the supporter caps.
# Required in test mode; ignored in live mode.
BILLING_TEST_USER_IDS=
# A restricted key (rk_test_…) with only the permissions listed in server/services/stripeClient.js.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_…). During a rotation: both, comma-separated.
STRIPE_WEBHOOK_SECRET=
# The Price sold to new subscribers: ¥500 JPY, monthly, tax-inclusive (checked at checkout; a passing check is reused for up to 10 minutes).
STRIPE_PRICE_ID=
# Earlier Prices that still count for existing subscribers (comma-separated); STRIPE_PRICE_ID is
# always accepted.
STRIPE_PRICE_IDS_ACCEPTED=
# The app's origin for Stripe's return links, e.g. https://app.<domain> (https, no path).
BILLING_RETURN_ORIGIN=
# The terms of service URL (the same one as in the Stripe Dashboard's public details). Required for
# live sales; when set, Checkout asks for consent to it.
BILLING_TOS_URL=
# All supporters together per Japan-time day ('*supporter' in ai_daily_usage; defaults 1000 and
# 200). 0 turns the kind off for supporters.
AI_CAP_SUPPORTER_GLOBAL_LLM=
AI_CAP_SUPPORTER_GLOBAL_COURSE_GENERATION=
