# Rise Path の公開の記録（git には入れません。秘密の値は書きません）
#   cp launch-record.env.example launch-record.env
# 書き方: 確かめをした日を YYYY-MM-DD で書きます（例: 2026-11-02）。数字と - と = は半角で書きます。
# 日付は、その名前の行の = のうしろに書きます（同じ名前の行を新しく足しません）。まだのものは空のままにします。
# 手順書（doc/guides/first-launch.ja.md）のチェックの横にも同じ日付を書きます。このファイルをなくしたときは、
# そこから写します（手順書 14 章）。この記録はオーナーの記録です。証明ではありません。
# 事前チェック（./scripts/preflight.sh）だけが読みます。シェルで source はしません。

# 公開の段階: setup → pilot → minors → public（手順書 5.2・9.6・11.8。段階の名前だけを書き、前やうしろに空白を入れません）
# minors は、18 歳未満が使うと決めたときだけ書きます（ふつうは pilot の次が public です）
LAUNCH_STAGE=setup
# Vercel の保護（All Deployments）をかけて、プライベートウィンドウで確かめた日（手順書 2.6）
VERCEL_PROTECTION_ON=
# Vercel の保護を外した日（手順書 10.3。名簿が動いてから）
VERCEL_PROTECTION_OFF=
# 安全の知らせを見る人（80 文字まで。例: 事務局の当番（2 人））（手順書 3.6）
ALERT_WATCHER=
# 安全の知らせを見る頻度（80 文字まで。例: 平日の 10 時と 16 時）（手順書 3.6）
ALERT_CHECK=
# 控えのバケットに、30 日で消す設定（ライフサイクル）を入れた日（手順書 3.8）
BACKUP_LIFECYCLE=
# 控えの鍵を、VM の外（パスワード管理）にしまった日（手順書 6.4）
BACKUP_KEY_COPY=
# 控えの鍵の key id（0〜9 と a〜f の 16 文字。秘密ではありません）（手順書 6.4）
BACKUP_KEY_ID=
# 試しの知らせが Slack に届いた日（手順書 9.4）
ALERT_TEST=
# 開発用の Mac が、本番の DB を使わなくなったことを確かめた日（手順書 9.5）
MAC_DEV_DB_SEPARATE=
# Supabase の「Require current password when updating」を入れた日（手順書 11.2）
SUPABASE_CURRENT_PASSWORD_ON=
# パスワードの変更の確かめが通った日（手順書 11.2）
PASSWORD_CHANGE_CHECK=
# 本番の amr の確かめが通った日（手順書 11.2）
PROD_AMR_CHECK=
# Vercel で VITE_FEATURE_LEGAL_PAGES=true にした日（手順書 12.1）
VERCEL_LEGAL_PAGES_ON=
# AI アプリの接続（byoa）を使うと決めた日（手順書 12.3。最初の公開では使いません）
DECIDED_BYOA=
# 学習の記憶（Memanto）を使うと決めた日（手順書 12.3。最初の公開では使いません）
DECIDED_MEMORY=
# 有料プランを使うと決めた日（手順書 12.3。最初の公開では使いません）
DECIDED_BILLING=
# 18 歳未満が使うときの決まりを、オーナーと弁護士が決めた日（公開の段階 minors と public で必要です。pilot の次が public でも要ります）
MINORS_POLICY_DECIDED=
