# Cloudflare Tunnel token (compose profile `tunnel`) — copy to tunnel.env (never commit tunnel.env)
#   cp tunnel.env.example tunnel.env && chmod 600 tunnel.env
# Paste the remotely-managed tunnel's token from the Cloudflare Zero Trust dashboard after the
# '=' on the VM only (never in chat, issues or git). Only the cloudflared service reads this file.
TUNNEL_TOKEN=
