# Rise Path VM stack — copy to stack.env (never commit stack.env)
# See doc/guides/risepath_vm_deployment.md (what to put in each value: deploy/risepath-vm/README.md)
#
# Canonical DB role: risepath_app (matches scripts/vm/postgres_risepath_bootstrap.sql)
# deploy-stack.sh stops before the build while POSTGRES_PASSWORD, DATABASE_URL_PHASE1, SUPABASE_URL,
# SUPABASE_SERVICE_ROLE_KEY or RISE_PATH_BRIDGE_TOKEN is empty or still a template value. The
# default COMPOSE_PROFILES=tts runs without Hermes: the shared Hermes agent is not offered to
# learners (doc/brushup-2026/ai-access-plan.ja.md). Only if you list full (Hermes, self-hosting or
# development) does it also need OPENROUTER_API_KEY and a HERMES_API_KEY of at least 16 characters.

# --- Postgres (db service) ---
POSTGRES_USER=risepath_app
# openssl rand -hex 24. Fixed at the db volume's first start: changing it here later does not change
# the password inside the database. Put the same value in DATABASE_URL_PHASE1 below.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=risepath

# --- API (api service) ---
DATABASE_URL_PHASE1=postgresql://risepath_app:change-me@db:5432/risepath
PORT=3006
NODE_ENV=production
# false: production data mode with strict auth (server/middleware/authPolicy.js). Read by api and
# mcp at runtime; the front end's value is set in Vercel.
VITE_DEMO_MODE=false

# Supabase Auth (JWT validation only — not Supabase Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
# Strict auth is already on with NODE_ENV=production; this forces it in any other mode
# RISEPATH_STRICT_AUTH=true

# --- LLM gateway (api service: /api/v2/llm; model ids only in server/llm/models.config.js) ---
# Production has no mock fallback: without ANTHROPIC_API_KEY (and with Gemini off), AI tutor calls
# answer 503. The AI tutor, writing feedback and course generation run on the cheap Claude model
# (Claude Haiku) by default.
# Check after deploy (no secrets), from deploy/risepath-vm on the VM:
#   docker compose --env-file stack.env exec -T api node scripts/smoke-vm-stack.mjs --target container
ANTHROPIC_API_KEY=
# Gemini (chat provider, RAG embeddings, image generation) is used ONLY when GEMINI_ALLOWED is
# exactly "true". Unset or anything else = off, even when GEMINI_API_KEY is set (the api logs a
# warning). Off by default: the Gemini API Additional Terms (https://ai.google.dev/gemini-api/terms)
# forbid services "directed towards or likely to be accessed by individuals under the age of 18",
# and minors use Rise Path. Set GEMINI_ALLOWED=true only for deployments that people under 18
# cannot reach. With it off: uploaded material is found by keyword search (no vectors), AI image
# generation is off (/api/v2/image answers 503), and course generation and the tutor run on Claude.
# Leave both empty on the learner-facing stack.
# GEMINI_ALLOWED=true
GEMINI_API_KEY=
# Force every task onto one provider: anthropic | gemini | mock
# LLM_PROVIDER=
# Per-task route: LLM_TASK_<TASK>=provider[:model]. To move a task back to the larger model:
# LLM_TASK_TUTOR_CHAT=anthropic:claude-sonnet-5-5
# LLM_TASK_WRITING_FEEDBACK=anthropic:claude-sonnet-5-5
# LLM_TASK_COURSE_GENERATE=anthropic:claude-sonnet-5-5
# 'true' lets the built-in mock answer when no key is set (demos only; off in production)
# LLM_MOCK_FALLBACK=false
# LLM_TIMEOUT_MS=120000
# Daily budget for anonymous (guest) tutor calls, in memory, reset at 00:00 JST. Guest calls do not
# count toward AI_CAP_GLOBAL_LLM below; this is their own total.
# LLM_GUEST_DAILY_PER_IP=100
# LLM_GUEST_DAILY_TOTAL=2000
# Daily caps on paid AI features for signed-in users (server/middleware/dailyCaps.js). The day is
# the Japan-time date (reset at 00:00 JST); counts are kept in ai_daily_usage (migration 013).
# USER is per user per day, IP per visitor address per day (an IPv6 visitor by its /56, as the
# guest budget and the per-minute limiter group them; default 3 x USER; loopback and private
# addresses are not counted), GLOBAL is all users together per day.
# 0 turns the feature off for everyone, guests included (the app says it is paused); there is
# no unlimited value (raise the number instead), so the GLOBAL caps always work as cost breakers. Admins
# (user_profiles.role = 'admin') skip the USER and IP caps, not the GLOBAL one. Bridge-token calls
# all run as PHASE1_USER_ID and share one USER count. Guests are not counted here (see the guest
# budget above). Without a database the counts are in memory and reset on restart. During a
# database outage each process counts again from 0 in memory: a user can get one more full USER
# cap that day, and the GLOBAL cap drops to a tenth meanwhile (about 1.1 x GLOBAL per process);
# past that tenth, callers get 503 "busy" (not the daily-limit notice) until the database answers.
# A school or office behind one address shares the IP cap: raise AI_CAP_IP_* for it.
# AI_DAILY_LIMIT is no longer read.
# AI_CAP_USER_LLM=50
# AI_CAP_IP_LLM=150
# AI_CAP_GLOBAL_LLM=1500
# AI_CAP_USER_COURSE_GENERATION=20
# AI_CAP_IP_COURSE_GENERATION=60
# AI_CAP_GLOBAL_COURSE_GENERATION=300
# AI_CAP_USER_IMAGE=30
# AI_CAP_IP_IMAGE=90
# AI_CAP_GLOBAL_IMAGE=300
# AI_CAP_USER_AGENT_CHAT=40
# AI_CAP_IP_AGENT_CHAT=120
# AI_CAP_GLOBAL_AGENT_CHAT=800
# AI_CAP_USER_EMBEDDINGS=10
# AI_CAP_IP_EMBEDDINGS=30
# AI_CAP_GLOBAL_EMBEDDINGS=100
# Reaching 80% and 100% of a GLOBAL cap is logged as an error ("[AI caps] global daily cap"),
# once a day per feature. Optional: also post it to a Slack- or Discord-style incoming webhook
# (https:// only; http:// only to localhost). The URL is a secret: it is never logged.
# AI_CAP_ALERT_WEBHOOK_URL=
# A GLOBAL count used up by something that was not real use (a provider key that was rejected,
# say): after the fix, reset that feature's all-users count for today. <kind> is llm,
# course_generation, image, agent_chat or embeddings; the day is the Japan-time date:
#   DELETE FROM ai_daily_usage WHERE usage_day = (now() AT TIME ZONE 'Asia/Tokyo')::date
#     AND kind = '<kind>' AND subject = '*';

# --- Public edge (Vercel app.<domain> → Cloudflare Tunnel api.<domain>) ---
# With these empty and TRUST_PROXY commented out, the stack deploys as before (origin gate off).
# For the tunnel, set all of them, fill tunnel.env, then switch COMPOSE_PROFILES to tts,tunnel;
# deploy-stack.sh refuses the tunnel profile while one is missing.
# Shared secret the Vercel route sends as x-origin-secret: openssl rand -hex 32. At least 32
# characters, and the same value as ORIGIN_SECRET in the Vercel Production env. Once set, every
# caller that is not loopback inside the api container needs the header, Tailscale peers of :3006
# included, and is then an edge request (no bridge-token auth).
ORIGIN_SECRET=
# Rotation only: the old value, accepted next to ORIGIN_SECRET until Vercel has the new one
# ORIGIN_SECRET_PREVIOUS=
# With the tunnel: 1, since cloudflared is one proxy hop; never true
# TRUST_PROXY=1
# Browser origin of the front end (comma-separated): https://app.<domain>. The API sees Host
# api.<domain>, so LLM calls from the app need it.
LLM_ALLOWED_ORIGINS=
# RISE_PATH_PUBLIC_URL must stay unset: absolute https://api.<domain> media URLs would get 403,
# relative /audio/cache URLs go through app.<domain>.

# --- Hermes (hermes service — compose profile `full`; off by default) ---
# The shared Hermes agent is not offered to learners: keep full out of COMPOSE_PROFILES and leave
# VITE_FEATURE_AGENT_CHAT unset in Vercel. It stays for self-hosting and development. To enable
# it, list full in COMPOSE_PROFILES (full or full,tunnel), set the two keys below, and set
# VITE_FEATURE_AGENT_CHAT=true both in the front end's build env and here (the api reads it too:
# without it POST /api/v2/agent/chat answers 404, even while Hermes runs).
# An older stack.env with COMPOSE_PROFILES=full: switch it to tts (or tts,tunnel) to stop Hermes.
# When COMPOSE_PROFILES lists full, deploy-stack.sh runs scripts/init-hermes-profile.sh.
# HERMES_API_KEY: openssl rand -hex 32 (at least 16 characters; deploy-stack.sh refuses a shorter
# one when COMPOSE_PROFILES lists full). It is the only Hermes key to
# set: docker-compose.yml and init-hermes-profile.sh copy it into Hermes as API_SERVER_KEY.
# Express proxy only; never expose it to the browser.
HERMES_API_URL=http://hermes:8642
HERMES_API_KEY=change-me-local-dev
API_SERVER_ENABLED=true
API_SERVER_PORT=8642
# Hermes model access. Required only while COMPOSE_PROFILES lists full: deploy-stack.sh stops
# while it is change-me. With the default tts it is not read.
OPENROUTER_API_KEY=change-me
# tts (default): kokoro-tts only, no hermes container. Add tunnel (tts,tunnel) after tunnel.env
# and the public-edge values above are set. full (self-hosting or development only): kokoro-tts +
# hermes, needs OPENROUTER_API_KEY and HERMES_API_KEY above (full,tunnel with the tunnel).
COMPOSE_PROFILES=tts
# Hermes MCP subprocess / tools also need DATABASE_URL_PHASE1 (same value as api)

# --- MCP SSE (mcp service) ---
# api + mcp + hermes share DATABASE_URL_PHASE1, SUPABASE_*, and NODE_ENV=production
MCP_SSE_PORT=3100
# Expose curriculum-builder + admin tools to Hermes (matches hermes/config.yaml allowlist)
RISE_PATH_MCP_PROFILE=admin
PHASE1_USER_ID=00000000-0000-0000-0000-000000000001
# Service-to-service auth for Hermes → MCP SSE (must match hermes config Authorization header).
# One shared secret for the whole stack: never give it to ChatGPT, Claude.ai or any outside
# service, and never publish port 3100 to the internet. Remote MCP clients come only after
# per-learner sign-in (OAuth). openssl rand -hex 32
RISE_PATH_BRIDGE_TOKEN=change-me-bridge-token
# lesson-upsert-draft store: this production SSE server refuses file drafts, so use db
# RP_LESSON_STORE=db

# --- Kokoro TTS (kokoro-tts service) ---
KOKORO_TTS_URL=http://kokoro-tts:8880
KOKORO_TTS_DEFAULT_VOICE_JA=jf_alpha
KOKORO_TTS_DEFAULT_VOICE_EN=af_bella

# --- Memanto learner memory (Phase 19 — compose overlay + profile memory) ---
# Needs e2-standard-2 (8 GB) or larger. To enable: MEMANTO_SECRET_KEY=<openssl rand -hex 32>,
# MEMANTO_ENABLED=true and "memory" in COMPOSE_PROFILES. MEMANTO_ENABLED=true is required in this
# file: the boot unit (systemd/risepath-stack.service) reads it, and deploy-stack.sh stops when the
# secret is set and this is not true.
# COMPOSE_PROFILES=tts,memory   (full,memory only if you enable Hermes)
MEMANTO_ENABLED=false
MEMANTO_SECRET_KEY=change-me-memanto-secret
MEMANTO_API_URL=http://memanto:8000
MEMANTO_API_PORT=8100
MEMANTO_SESSION_DURATION_HOURS=24
MEMANTO_RECALL_LIMIT=8
MEMANTO_MIN_CONFIDENCE_WRITE=0.7
MOORCHEH_EMBEDDING_MODEL=nomic-embed-text
MOORCHEH_LLM_MODEL=qwen2.5:0.5b
