# Public remote MCP (compose service mcp-public, profile byoa) — copy to mcp-public.env on the VM
#   cp mcp-public.env.example mcp-public.env && chmod 600 mcp-public.env
# Never commit mcp-public.env. Owner steps in order: doc/guides/byoa-setup.ja.md.
#
# Only mcp-public reads this file, and it reads nothing else (not stack.env). Keep it that way:
# never add RISE_PATH_BRIDGE_TOKEN, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY, GEMINI_*,
# OPENROUTER_API_KEY, HERMES_*, MEMANTO_*, ORIGIN_SECRET or RISE_PATH_ACTIVE_SESSION_KEY here.
# The server is reachable from the internet; a leak from it must not reach anything else.

# Least-privilege Postgres role made by sql/mcp_remote_role.sql (NOT risepath_app, which is a
# superuser). Same db host and database as stack.env; only the user and password differ.
DATABASE_URL_PHASE1=postgresql://risepath_mcp_remote:change-me@db:5432/risepath

# Supabase project (the same project as stack.env). The access-token issuer is SUPABASE_URL +
# '/auth/v1'. The anon key is public (it also ships in the front end); the service-role key must
# never be here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Canonical resource URL: https, a path, no trailing slash, written exactly like this. Its host is
# the only Host the server accepts, and the Custom Access Token Hook
# (deploy/supabase/custom_access_token_hook.sql) must write the very same string as aud.
MCP_PUBLIC_RESOURCE_URL=https://mcp.your-domain.example/mcp

# Browser origins allowed to call /mcp with CORS (comma list, scheme://host[:port]). Agents such
# as Claude Code, Codex, Claude.ai, ChatGPT, Cursor and VS Code call from a server or a desktop
# process and send no Origin, so leave it empty. A request that sends any other Origin gets 403.
MCP_ALLOWED_ORIGINS=

# The app origin (Vercel), for the /settings/ai-access link in adults-only refusals, such as
# https://app.<your domain>. Optional: left empty, refusals carry no link. deploy-stack.sh refuses
# a template value here.
APP_PUBLIC_URL=

# Fixed by docker-compose.yml as well (the compose values win). The server refuses to start
# outside production.
NODE_ENV=production
RISE_PATH_MCP_PROFILE=learner-remote

# --- Optional (defaults shown) ---
# Daily caps per Japan-time day (server/middleware/dailyCaps.js; reset at 00:00 JST). mcp counts
# every tools/call, mcp_write also counts journal-log and learner-state-update. These kinds have
# no per-address cap (Claude.ai and ChatGPT call from shared vendor addresses). 0 turns the
# remote tools off for everyone.
# AI_CAP_USER_MCP=300
# AI_CAP_GLOBAL_MCP=20000
# AI_CAP_USER_MCP_WRITE=50
# AI_CAP_GLOBAL_MCP_WRITE=5000
# Alerts at 80% and 100% of a global cap (incoming webhook, https:// only). A secret: it is never
# logged. Use a separate webhook from stack.env's if you can.
# AI_CAP_ALERT_WEBHOOK_URL=
# Keep the same value as stack.env when you changed it there (blocked inputs a day before a
# learner's AI pauses; the pause applies to connected agents too).
# SAFETY_BLOCKS_BEFORE_PAUSE=10
