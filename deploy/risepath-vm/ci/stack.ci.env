# risepath-ci-env: CI only. scripts/ci/stack.sh copies this file to deploy/risepath-vm/stack.env for one
# run of .github/workflows/e2e.yml ("Server stack deploy") or npm run ci:stack, then deletes the copy.
# Dummy values: none is a secret, none works outside the throwaway CI stack. Never copy it to the VM.
# server/tests/ciScripts.test.js pins every KEY=value line exactly (the comments are free text).
COMPOSE_PROJECT_NAME=risepath-ci
COMPOSE_PROFILES=
POSTGRES_USER=risepath_app
POSTGRES_PASSWORD=ci-dummy-db-password
POSTGRES_DB=risepath
DATABASE_URL_PHASE1=postgresql://risepath_app:ci-dummy-db-password@db:5432/risepath
NODE_ENV=production
VITE_DEMO_MODE=false
# A name on this stack's network that nothing answers in "Server stack deploy": health needs only a
# non-empty URL and key, and neither health nor the smoke calls it.
SUPABASE_URL=http://auth-stand-in:54390
SUPABASE_SERVICE_ROLE_KEY=ci-dummy-service-role-key
RISE_PATH_BRIDGE_TOKEN=ci-dummy-bridge-token
# AI off: no model keys, no LLM_* settings (the smoke only warns).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# The origin gate stays off (ORIGIN_SECRET empty): the CI stack has no edge; the gate has its unit tests.
ORIGIN_SECRET=
LLM_ALLOWED_ORIGINS=
MEMANTO_ENABLED=false
MEMANTO_SECRET_KEY=
# Self-service account deletion: on in the CI stack only (stack.env.example keeps it off).
ACCOUNT_DELETION_ENABLED=true
