# 毎日の控え（バックアップ）の設定 (Phase 9, owner decision D4; doc/guides/first-launch.ja.md 6.4).
# 書き方: BACKUP_BUCKET= のうしろにバケットの名前を書いて保存し、install-backup.sh を、前と同じ指定でもう一度実行します（手順書 6.4）。
# BACKUP_ALERT_WEBHOOK_URL を書いたら、このファイルは秘密です（画面に出したり、どこかに貼ったりしません）。
# install-backup.sh copies this file to /etc/risepath-backup/backup.env (root, 0600) on its first run and stops;
# write the bucket name there with `sudo nano /etc/risepath-backup/backup.env`, then run install-backup.sh again.
# The scripts read each line with a fixed pattern (never `source`): NAME=value, no spaces, no quotes needed.
# No secret unless BACKUP_ALERT_WEBHOOK_URL is set: that is a Slack webhook URL, so never print, paste or share the
# copy in /etc/risepath-backup/ (the key is /etc/risepath-backup/backup.key; the usual Slack URL stays in stack.env).

# バケットの名前（手順書 3.8 で作ったもの。例: <project>-risepath-backup）。英小文字、数字、- . _ だけです。
BACKUP_BUCKET=
# VM の中に残す毎日の控えの日数（ふつうは 3 のままにします）。
BACKUP_KEEP_LOCAL_DAYS=3
# バケットに残す日数（バケットのライフサイクルと同じ数。弁護士に確かめるまで 30 です）。削除の記録は、この日数 + 10 日ぶんを控えます。
BACKUP_RETENTION_DAYS=30
# 失敗の知らせを、stack.env の AI_CAP_ALERT_WEBHOOK_URL とはちがう Slack に送るときだけ書きます（https の URL）。ふつうは空のままにします。
BACKUP_ALERT_WEBHOOK_URL=
