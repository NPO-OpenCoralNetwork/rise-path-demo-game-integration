# Vercel → Project Settings → Environment Variables: Production only (placeholders, no real values).
# Preview gets neither API_ORIGIN nor ORIGIN_SECRET: previews would use the production DB and LLM budget.

# Server side only: vercel.json routes proxy /api/*, /audio/cache/* and /generated/img_* here.
# Scheme and host only, with no trailing slash or path. Never as a VITE_ variable.
API_ORIGIN=https://api.example.com
# The same value as ORIGIN_SECRET in the VM's deploy/risepath-vm/stack.env (openssl rand -hex 32,
# generated on the VM). Sent as the x-origin-secret request header. Never as a VITE_ variable.
ORIGIN_SECRET=

VITE_DEMO_MODE=false
VITE_API_ENABLED=true
VITE_SUPABASE_URL=https://your-project.supabase.co
# The anon key only, never the service role key
VITE_SUPABASE_ANON_KEY=your-anon-key

# Do NOT set VITE_API_BASE_URL: unset, the client calls same-origin /api/v2 (services/apiClient.ts).
# Delete the old Tailscale value (http://risepath-vm:3006/api/v2) if the project still has it.

# Do NOT set VITE_FEATURE_AGENT_CHAT: the shared Hermes chats (floating AI coach, /life-journal/chat)
# show only when it is exactly true, and the shared Hermes agent is not offered to learners.

# Optional: subpath deploy
# VITE_APP_BASE_PATH=/
