{
  "context": {
    "fileName": ["AGENTS.md", "GEMINI.md"]
  },
  "mcpServers": {
    "rise-path-learning": {
      "command": "node",
      "args": ["mcp-server/index.js", "--profile", "curriculum-builder"],
      "env": {
        "RP_LESSON_STORE": "fs"
      },
      "timeout": 30000
    },
    "miro-mcp": {
      "command": "node",
      "args": ["scripts/miro_mcp_wrapper.js"]
    }
  }
}
